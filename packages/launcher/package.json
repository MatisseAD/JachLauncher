{
  "name": "@jach/launcher",
  "version": "3.0.3",
  "private": true,
  "description": "Launcher Minecraft adaptatif — applique un manifeste distant au runtime",
  "author": "YourLauncher",
  "homepage": "https://yourlauncher.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatisseAD/JachLauncher.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "node -e \"require('./electron-builder.config.cjs')\" && electron-vite build && electron-builder --config electron-builder.config.cjs",
    "package:win": "node -e \"require('./electron-builder.config.cjs')\" && electron-vite build && electron-builder --config electron-builder.config.cjs --win --publish never"
  },
  "dependencies": {
    "@azure/msal-node": "^5.5.0",
    "@jach/shared": "*",
    "@jach/ui": "*",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "6.1.2",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/tar": "^6.1.13",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "yazl": "^3.3.1"
  }
}