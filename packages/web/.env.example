# PostgreSQL local lancé par `docker compose up -d`
DATABASE_URL="postgresql://yourlauncher:yourlauncher@localhost:5432/yourlauncher?schema=public"

# Connexion directe réservée aux migrations. Sur Supabase, utiliser la
# connexion directe ou le pooler Session (port 5432), jamais Transaction (6543).
DIRECT_URL="postgresql://yourlauncher:yourlauncher@localhost:5432/yourlauncher?schema=public"

# Au moins 32 caractères. Générer une valeur différente en production.
AUTH_SECRET="change-me-with-at-least-thirty-two-characters"

# Origine canonique utilisée dans les manifestes publics.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Recommandé en production : générer avec `npm run key:generate`.
# MANIFEST_SIGNING_PRIVATE_KEY=""

# Optionnels
# BLOB_READ_WRITE_TOKEN=""
# Seed uniquement : 12 caractères minimum. En production, ajouter aussi
# ALLOW_DEMO_SEED="true" pour confirmer explicitement l'opération.
# DEMO_PASSWORD=""
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXX"
# URL HTTPS du dernier installateur desktop (GitHub Release, CDN, etc.).
# NEXT_PUBLIC_LAUNCHER_DOWNLOAD_URL="https://example.com/YourLauncher-Setup.exe"
