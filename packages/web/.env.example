# Copie ce fichier en .env et adapte les valeurs.

# --- Local (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Production / Vercel (PostgreSQL) ---
# Passe aussi le provider en "postgresql" dans prisma/schema.prisma (voir DEPLOY.md).
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret de signature des cookies de session (chaîne aléatoire longue).
AUTH_SECRET="remplace-par-une-chaine-aleatoire-longue"

# Uploads d'images : Vercel Blob (auto-injecté si tu crées un store Blob).
# Sans ce token, les uploads vont sur le disque local (dev uniquement).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXX"

# Publicités (optionnel) — laisse vide pour afficher des placeholders.
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
