# Copie ce fichier en .env et adapte les valeurs.

# --- Local (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Production / Vercel (PostgreSQL) ---
# Passe aussi le provider en "postgresql" dans prisma/schema.prisma (voir DEPLOY.md).
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret de signature des cookies de session (chaîne aléatoire longue).
AUTH_SECRET="remplace-par-une-chaine-aleatoire-longue"

# Publicités (optionnel) — laisse vide pour afficher des placeholders.
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
