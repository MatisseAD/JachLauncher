# PostgreSQL local lancé par `docker compose up -d`
DATABASE_URL="postgresql://yourlauncher:yourlauncher@localhost:5432/yourlauncher?schema=public"

# Au moins 32 caractères. Générer une valeur différente en production.
AUTH_SECRET="change-me-with-at-least-thirty-two-characters"

# Origine canonique utilisée dans les manifestes publics.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Recommandé en production : générer avec `npm run key:generate`.
# MANIFEST_SIGNING_PRIVATE_KEY=""

# Optionnels
# BLOB_READ_WRITE_TOKEN=""
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXX"
