// Schéma Prisma canonique — PostgreSQL en local, CI et production.
// Une seule variable est utilisée partout : DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  email              String?           @unique
  avatarUrl          String?
  password           String // hash bcrypt
  role               String            @default("user")
  disabledAt         DateTime?         @db.Timestamptz(3)
  disabledReason     String?
  disabledById       String?
  disabledBy         User?             @relation("UserDisabler", fields: [disabledById], references: [id], onDelete: Restrict)
  disabledUsers      User[]            @relation("UserDisabler")
  lastLoginAt        DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  launchers          Launcher[]
  suspendedLaunchers Launcher[]        @relation("LauncherSuspender")
  createdPlayerBans  PlayerBan[]       @relation("PlayerBanCreator")
  revokedPlayerBans  PlayerBan[]       @relation("PlayerBanRevoker")
  adminAuditLogs     AdminAuditLog[]   @relation("AdminAuditActor")
  uploadUsage        UserUploadUsage[]

  @@index([disabledById])
  @@index([disabledAt])
  @@index([role, disabledAt])
  @@index([lastLoginAt])
  @@index([createdAt, id])
}

model Launcher {
  id      String @id @default(cuid())
  // "slug" = le code que le joueur entre dans le launcher desktop.
  slug    String @unique
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // --- Méta ---
  title            String
  description      String    @default("")
  status           String    @default("draft") // draft | ready | published
  favorite         Boolean   @default(false)
  suspendedAt      DateTime? @db.Timestamptz(3)
  suspensionReason String?
  suspendedById    String?
  suspendedBy      User?     @relation("LauncherSuspender", fields: [suspendedById], references: [id], onDelete: Restrict)

  // --- Branding / apparence ---
  logoUrl            String?
  backgroundUrl      String?
  primaryColor       String  @default("#5b8cff")
  secondaryColor     String  @default("#00d18f")
  textColor          String  @default("#e6edf3")
  theme              String  @default("dark") // dark | light
  visualStyle        String  @default("premium") // premium | dark | light | pixel | medieval | futuristic
  buttonStyle        String  @default("glow") // glow | flat | pixel | outline
  cardShape          String  @default("rounded") // rounded | sharp | pill
  menuPlacement      String  @default("left") // left | top
  backgroundFit      String  @default("cover") // cover | contain | fill
  backgroundPosition String  @default("center") // center | top | bottom | left | right
  backgroundOverlay  Int     @default(48) // 0..90
  backgroundBlur     Int     @default(0) // 0..20 px
  panelOpacity       Int     @default(72) // 20..100
  fontFamily         String  @default("poppins") // poppins | inter | system | serif | pixel
  cornerRadius       Int     @default(14) // 0..32 px
  contentDensity     String  @default("comfortable") // compact | comfortable | spacious
  sidebarStyle       String  @default("glass") // glass | solid | floating
  logoShape          String  @default("rounded") // square | rounded | circle
  playButtonLabel    String  @default("JOUER")
  showServerStatus   Boolean @default(true)
  showNews           Boolean @default(true)
  showDiscord        Boolean @default(false)
  showWebsite        Boolean @default(false)
  discordUrl         String?
  websiteUrl         String?
  supportUrl         String?
  ambiance           String  @default("none") // none | fire | snow | stars | rain | glitch

  // --- Minecraft ---
  mcVersion        String  @default("1.20.1")
  loader           String  @default("vanilla")
  loaderVersion    String?
  javaMajor        Int?
  launcherType     String  @default("vanilla") // vanilla | modded | private | minigames | survival | rp
  serverAddress    String?
  serverPort       Int?
  preLaunchMessage String  @default("")

  // --- Mémoire JVM (Mo) ---
  memMin Int @default(1024)
  memMax Int @default(4096)

  // --- Blobs JSON ---
  mods          String @default("[]")
  resourcepacks String @default("[]")
  shaderpacks   String @default("[]")
  news          String @default("[]")
  events        String @default("[]")
  patchNotes    String @default("[]")
  maintenance   String @default("{\"active\":false}")
  alert         String @default("{\"active\":false,\"kind\":\"info\",\"message\":\"\"}")
  jvmArgs       String @default("[]")

  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  dailyMetrics LauncherDailyMetric[]
  playerBans   PlayerBan[]

  @@index([ownerId])
  @@index([suspendedById])
  @@index([suspendedAt])
  @@index([createdAt, id])
}

// Historique conservé pour compatibilité de migration. Les écritures basées sur
// un simple en-tête desktop ont été désactivées car elles n'étaient pas fiables.
model LauncherDailyMetric {
  id            String   @id @default(cuid())
  launcherId    String
  launcher      Launcher @relation(fields: [launcherId], references: [id], onDelete: Cascade)
  day           DateTime @db.Date
  manifestLoads Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([launcherId, day])
}

// Quota journalier partagé par toutes les instances et toutes les routes
// d'upload. Aucune information sur les fichiers ou les visiteurs n'est stockée.
model UserUploadUsage {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  bytes     Int      @default(0)
  uploads   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, day])
}

// Interdiction d'accès d'un joueur, globale ou limitée à un launcher.
// Les identifiants sont normalisés dans l'API avant toute écriture/recherche.
model PlayerBan {
  id           String    @id @default(cuid())
  launcherId   String?   @map("launcher_id")
  launcher     Launcher? @relation(fields: [launcherId], references: [id], onDelete: Cascade)
  subjectType  String    @map("subject_type")
  subjectValue String    @map("subject_value")
  reason       String
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById  String    @map("created_by_id")
  createdBy    User      @relation("PlayerBanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revokedById  String?   @map("revoked_by_id")
  revokedBy    User?     @relation("PlayerBanRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([launcherId], map: "player_bans_launcher_id_idx")
  @@index([createdById], map: "player_bans_created_by_id_idx")
  @@index([revokedById], map: "player_bans_revoked_by_id_idx")
  @@index([subjectType, subjectValue, revokedAt, expiresAt], map: "player_bans_access_idx")
  @@index([createdAt, id], map: "player_bans_created_at_id_idx")
  @@map("player_bans")
}

// Journal de sécurité append-only. Une migration ajoute un trigger qui refuse
// UPDATE et DELETE, y compris lorsqu'ils sont tentés via Prisma.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId], map: "admin_audit_logs_actor_id_idx")
  @@index([createdAt, id], map: "admin_audit_logs_created_at_id_idx")
  @@index([action, createdAt], map: "admin_audit_logs_action_created_at_idx")
  @@map("admin_audit_logs")
}
